# Port for HTTP server (default: 3001)
PORT=3001

# Port for HTTPS server (default: 3443)
HTTPS_PORT=3443

# Path to SQLite database file (default: ./database.sqlite)
DB_PATH=./database.sqlite

# Path to Postgres DB
# DATABASE_URL="postgresql://mfs_user:mfs5252@localhost:5432/mfs_character_builder"

# Comma-separated list of allowed CORS origins
# Example: http://localhost:5173,https://localhost:3443
CORS_ORIGIN=http://localhost:5173,https://localhost:3443

# Secret key for JWT signing (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node environment (development, production, etc.)
NODE_ENV=development