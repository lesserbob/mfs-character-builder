generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../database.sqlite"
}

model Creature {
  id        Int      @id @default(autoincrement())
  name      String
  level     Int      @default(1)
  might       Int      @default(10)
  agility     Int     @default(10)
  intellect   Int     @default(10)
  spirit      Int     @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id              Int       @id @default(autoincrement())
  classification  String // Will hold enum. Race class or specilalistion
  minMight   Int? // Only for race
  minAgility Int? // Only for race
  minIntellect Int? // Only for race
  minSpirit  Int? // Only for race
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}