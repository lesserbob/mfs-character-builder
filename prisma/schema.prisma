generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../database.sqlite"
}

enum ClassClassification {
  RACE
  PATH
  SPECIALISATION
}

model Creature {
  id        Int    @id @default(autoincrement())
  name      String
  level     Int    @default(1)
  might     Int    @default(0)
  agility   Int    @default(0)
  intellect Int    @default(0)
  spirit    Int    @default(0)
}

model Class {
  id             Int                 @id @default(autoincrement())
  name           String
  classification ClassClassification
  minMight       Int?
  minAgility     Int?
  minIntellect   Int?
  minSpirit      Int?
  
  // Relationship to ClassLevel
  classLevels    ClassLevel[]
}

model ClassLevel {
  id             Int    @id @default(autoincrement())
  classId        Int
  level          Int
  health         Int
  statBonus      Int  @default(0)
  
  // Relationship to Class
  class          Class  @relation(fields: [classId], references: [id])
  
  // Relationship to ClassFeature
  classFeatures  ClassFeature[]
}

model ClassFeature {
  id          Int    @id @default(autoincrement())
  name        String
  Description String
  classLevelId Int
  
  // Relationship to ClassLevel
  classLevel  ClassLevel @relation(fields: [classLevelId], references: [id])
}
