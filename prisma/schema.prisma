generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../database.sqlite"
}

enum ClassClassification {
  RACE
  PATH
  SPECIALISATION
}

enum ClassFeatureType {
  BASE
  SELECT
}

enum UserType {
  PLAYER
  GM
}

enum ActionType {
  STANDARD
  MINOR
  REACTION
  FREE
  MOVE
}

enum GearType {
  MELEE
  RANGED
  ARMOR
  MISCELLANEOUS
}

enum RateOfFire {
  SINGLE
  BURST
  FULL
}

enum Range {
  NEARBY
  MEDIUM
  LONG
  EXTREME
}

enum Reliability {
  RELIABLE
  NORMAL
  UNRELIABLE
}

enum ArmorType {
  OUTFIT
  HARDENED
}

enum CreatureType {
  PLAYER
  ANTAGONIST
}

enum FactionType {
  PLAYER
  NPC
}

model Creature {
  id        Int    @id @default(autoincrement())
  name      String
  level     Int    @default(1)
  might     Int    @default(0)
  agility   Int    @default(0)
  intellect Int    @default(0)
  spirit    Int    @default(0)
  wealth    Int    @default(0)
  userId    Int
  portrait      String?
  type          String @default("PLAYER")
  baseHealth    Int    @default(0)

  // Relationship to CreatureClass
  classes   CreatureClass[]

  // Relationship to CreatureSelectedFeatures
  features     CreatureSelectedFeature[]

  // Relationship to user
  user          User  @relation(fields: [userId], references: [id])

  // Relationship to CreatureItem
  items         CreatureItem[]

  // Relationship to CreatureBespokeFeature
  bespokeFeatures CreatureBespokeFeature[]

  // Relationship to Actor
  actors        Actor[]
}

model CreatureSelectedFeature {
    id                Int    @id @default(autoincrement())
    creatureId        Int
    featureId         Int

    // Relationship to Creature
    creature      Creature @relation(fields: [creatureId], references: [id])

    // Relationship to SelectableFeature
    feature       SelectableFeature @relation(fields: [featureId], references: [id])
}

model CreatureClass {
  id          Int    @id @default(autoincrement())
  creatureId  Int
  classId     Int
  
  // Relationship to Creature
  creature    Creature @relation(fields: [creatureId], references: [id])
  
  // Relationship to Class
  class       Class    @relation(fields: [classId], references: [id])
}

model Class {
  id             Int                 @id
  name           String
  classification ClassClassification
  minMight       Int?
  minAgility     Int?
  minIntellect   Int?
  minSpirit      Int?

  // Relationship to ClassLevel
  classLevels    ClassLevel[]

  // Relationship to CreatureClass
  creatureClasses CreatureClass[]
}

model ClassLevel {
  id             Int    @id @default(autoincrement())
  classId        Int
  level          Int
  health         Int
  statBonus      Int  @default(0)
  
  // Relationship to Class
  class          Class  @relation(fields: [classId], references: [id])
  
  // Relationship to ClassFeature
  classFeatures  ClassFeature[]
}

model ClassFeature {
  id                      Int    @id @default(autoincrement())
  name                    String
  description             String
  classLevelId            Int
  type                    ClassFeatureType
  display                 Boolean @default(true)
  enduranceRegeneration   Int?
  selectableFeatureListId Int?
  selectableFeatureCount  Int?
  
  // Relationship to ClassLevel
  classLevel  ClassLevel @relation(fields: [classLevelId], references: [id])

  // Relationship to SelectableFeatureList
  selectableFeatureList SelectableFeatureList? @relation(fields: [selectableFeatureListId], references: [id])
}

model CreatureBespokeFeature {
  id                      Int    @id @default(autoincrement())
  creatureId              Int
  name                    String
  description             String

  // Relationship to Creature
  creature    Creature @relation(fields: [creatureId], references: [id])
}

model SelectableFeatureList {
  id                  Int    @id
  name                String

  selectableFeatures  SelectableFeature[]
  classFeatures       ClassFeature[]
}

model SelectableFeature {
  id                          Int    @id
  name                        String
  description                 String
  selectableFeatureListId     Int
  requiredSelectableFeatureId Int?
  uses                        Int?
  actionType                  ActionType?

  selectableFeatureList  SelectableFeatureList @relation(fields: [selectableFeatureListId], references: [id])

  // Self-referencing relationship for required features
  requiredFeature        SelectableFeature?  @relation("FeatureRequirements", fields: [requiredSelectableFeatureId], references: [id])
  requiredByFeatures     SelectableFeature[] @relation("FeatureRequirements")

  // Relationship to CreatureSelectedFeature
  selectedFeatures  CreatureSelectedFeature[]
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
  type     UserType @default(PLAYER)

  // Relationship to Creature
  features     Creature[]
}

model Item {
  id                          Int    @id
  name                        String
  type                        GearType
  rank                        Int
  damageUnarmored             Int?
  damageArmored               Int?
  concealable                 Boolean @default(false)
  twoHanded                   Boolean @default(false)
  reach                       Boolean @default(false)
  finesse                     Boolean @default(false)
  thrown                      Boolean @default(false)
  attacksWorthOfAmmo          Int?
  rateOfFire                  RateOfFire?
  range                       Range?
  reliability                 Reliability?
  scatter                     Boolean @default(false)
  sniper                      Boolean @default(false)
  brace                       Boolean @default(false)
  armorType                   ArmorType?
  soak                        Int?

  // Relationship to CreatureItem
  creatures         CreatureItem[]
}

model CreatureItem {
  id          Int    @id @default(autoincrement())
  creatureId  Int
  itemId      Int
  quantity    Int   @default(0)

  // Relationship to Creature
  creature  Creature @relation(fields: [creatureId], references: [id])

    // Relationship to item
  item      Item @relation(fields: [itemId], references: [id])
}

model Story {
  id                      Int    @id @default(autoincrement())
  name                    String
  description             String

  // Relationship to Faction
  factions         Faction[]

  // Relationship to actors
  actors            Actor[]

  // Relationship to Locations
  Locations         Location[]
}

// A faction is a group within a story. A collective of actors
model Faction {
  id                      Int    @id @default(autoincrement())
  name                    String
  description             String
  storyId                 Int
  type                    FactionType

  // Relationship to Story
  story  Story         @relation(fields: [storyId], references: [id])

  // Relationpship to actors
  actors    Actor[]
}

// An actor is a single instance of a creature within a story
// An actor can be a player character, which are enforced singleton
// An actor can be an antagonist, which allow multiple instances
model Actor {
  id                      Int     @id @default(autoincrement())
  creatureId              Int
  storyId                 Int
  factionId               Int
  enduranceDamage         Int     @default(0)
  healthDamage            Int     @default(0)
  momentumSpent           Int     @default(0)
  actionPoints            Int     @default(0)
  standardActions         Int     @default(0)
  tacticalSurgeToken      Boolean @default(true)
  tacticalActionsTaken    Int     @default(0)
  acting                  Boolean @default(false)

  // Relation to story
  story  Story         @relation(fields: [storyId], references: [id])

  // Relation to creature
  creature  Creature   @relation(fields: [creatureId], references: [id])

  // Relationship to Faction
  faction   Faction    @relation(fields: [factionId], references: [id])
}

// Location is a place with a story
// Locations contain many zones
model Location {
  id                      Int    @id @default(autoincrement())
  name                    String
  description             String
  storyId                 Int

  // Relation to story
  story  Story         @relation(fields: [storyId], references: [id])

  // Relationshipo to zone
  zones     Zone[]
}

// A zone is a single place within a Location
model Zone {
  id                      Int    @id @default(autoincrement())
  name                    String
  description             String

  // Relationship to Location
  Locations    Location[]

  // Relationship to ZoneLink (zoneOne)         
  zoneOneLinks ZoneLink[] @relation("ZoneOne")

  // Relationship to ZoneLink (zoneTwo)         
  zoneTwoLinks ZoneLink[] @relation("ZoneTwo")

}

// A zone line is an association of one zone with another
// This basically means a zone can be moved to from another
model ZoneLink {
  id                      Int    @id @default(autoincrement())
  zoneOneId               Int
  zoneTwoId               Int

  // ZoneOne Relationship to Zone
  zoneOne   Zone  @relation("ZoneOne", fields: [zoneOneId], references: [id])

  // ZoneTwo Relationship to Zone
  zoneTwo   Zone  @relation("ZoneTwo", fields: [zoneTwoId], references: [id])

  @@unique([zoneOneId, zoneTwoId]) // Optional: prevent duplicates
}