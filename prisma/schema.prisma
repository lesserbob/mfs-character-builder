generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../database.sqlite"
}

enum ClassClassification {
  RACE
  PATH
  SPECIALISATION
}

enum classFeatureType {
  BASE
  SELECT
}

model Creature {
  id        Int    @id @default(autoincrement())
  name      String
  level     Int    @default(1)
  might     Int    @default(0)
  agility   Int    @default(0)
  intellect Int    @default(0)
  spirit    Int    @default(0)

  // Relationship to CreatureClass
  classes   CreatureClass[]

  // Relationship to CreatureSelectedItems
  features     CreatureSelectedFeature[]
}

model CreatureSelectedFeature {
    id                Int    @id @default(autoincrement())
    creatureId        Int
    featureId         Int

    // Relationship to Creature
    creature      Creature @relation(fields: [creatureId], references: [id])

    // Relationship to Creature
    feature           SelectableListItem @relation(fields: [featureId], references: [id])
}

model CreatureClass {
  id          Int    @id @default(autoincrement())
  creatureId  Int
  classId     Int
  
  // Relationship to Creature
  creature    Creature @relation(fields: [creatureId], references: [id])
  
  // Relationship to Class
  class       Class    @relation(fields: [classId], references: [id])
}

model Class {
  id             Int                 @id @default(autoincrement())
  name           String
  classification ClassClassification
  minMight       Int?
  minAgility     Int?
  minIntellect   Int?
  minSpirit      Int?

  // Relationship to ClassLevel
  classLevels    ClassLevel[]

  // Relationship to CreatureClass
  creatureClasses CreatureClass[]
}

model ClassLevel {
  id             Int    @id @default(autoincrement())
  classId        Int
  level          Int
  health         Int
  statBonus      Int  @default(0)
  
  // Relationship to Class
  class          Class  @relation(fields: [classId], references: [id])
  
  // Relationship to ClassFeature
  classFeatures  ClassFeature[]
}

model ClassFeature {
  id               Int    @id @default(autoincrement())
  name             String
  description      String
  classLevelId     Int
  type             classFeatureType
  selectableListId Int?
  selectableCount  Int?
  
  // Relationship to ClassLevel
  classLevel  ClassLevel @relation(fields: [classLevelId], references: [id])

  // Relationship to SelectableList
  selectableList SelectableList? @relation(fields: [selectableListId], references: [id])
}

model SelectableList {
  id              Int    @id @default(autoincrement())
  name            String

  selectableItems SelectableListItem[]
  classFeatures   ClassFeature[]
}

model SelectableListItem {
  id                Int    @id @default(autoincrement())
  name              String
  description       String
  selectableListId  Int

  selectableList  SelectableList @relation(fields: [selectableListId], references: [id])

  // Relationship to CreatureSelectedFeature
  selectedFeatures  CreatureSelectedFeature[]
}