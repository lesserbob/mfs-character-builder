generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../database.sqlite"
}

enum ClassClassification {
  RACE
  PATH
  SPECIALISATION
}

enum ClassFeatureType {
  BASE
  SELECT
}

enum UserType {
  PLAYER
  GM
}

enum ActionType {
  STANDARD
  MINOR
  REACTION
  FREE
  MOVE
}

enum GearType {
  MELEE
  RANGED
  ARMOR
  MISCELLANEOUS
}

enum RateOfFire {
  SINGLE
  BURST
  FULL
}

enum Range {
  NEARBY
  MEDIUM
  LONG
  EXTREME
}

enum Reliability {
  RELIABLE
  NORMAL
  UNRELIABLE
}

enum ArmorType {
  OUTFIT
  HARDENED
}

model Creature {
  id        Int    @id @default(autoincrement())
  name      String
  level     Int    @default(1)
  might     Int    @default(0)
  agility   Int    @default(0)
  intellect Int    @default(0)
  spirit    Int    @default(0)

  // Relationship to CreatureClass
  classes   CreatureClass[]

  // Relationship to CreatureSelectedFeatures
  features     CreatureSelectedFeature[]
}

model CreatureSelectedFeature {
    id                Int    @id @default(autoincrement())
    creatureId        Int
    featureId         Int

    // Relationship to Creature
    creature      Creature @relation(fields: [creatureId], references: [id])

    // Relationship to SelectableFeature
    feature       SelectableFeature @relation(fields: [featureId], references: [id])
}

model CreatureClass {
  id          Int    @id @default(autoincrement())
  creatureId  Int
  classId     Int
  
  // Relationship to Creature
  creature    Creature @relation(fields: [creatureId], references: [id])
  
  // Relationship to Class
  class       Class    @relation(fields: [classId], references: [id])
}

model Class {
  id             Int                 @id
  name           String
  classification ClassClassification
  minMight       Int?
  minAgility     Int?
  minIntellect   Int?
  minSpirit      Int?

  // Relationship to ClassLevel
  classLevels    ClassLevel[]

  // Relationship to CreatureClass
  creatureClasses CreatureClass[]
}

model ClassLevel {
  id             Int    @id @default(autoincrement())
  classId        Int
  level          Int
  health         Int
  statBonus      Int  @default(0)
  
  // Relationship to Class
  class          Class  @relation(fields: [classId], references: [id])
  
  // Relationship to ClassFeature
  classFeatures  ClassFeature[]
}

model ClassFeature {
  id                      Int    @id @default(autoincrement())
  name                    String
  description             String
  classLevelId            Int
  type                    ClassFeatureType
  display                 Boolean @default(true)
  enduranceRegeneration   Int?
  selectableFeatureListId Int?
  selectableFeatureCount  Int?
  
  // Relationship to ClassLevel
  classLevel  ClassLevel @relation(fields: [classLevelId], references: [id])

  // Relationship to SelectableFeatureList
  selectableFeatureList SelectableFeatureList? @relation(fields: [selectableFeatureListId], references: [id])
}

model SelectableFeatureList {
  id                  Int    @id
  name                String

  selectableFeatures  SelectableFeature[]
  classFeatures       ClassFeature[]
}

model SelectableFeature {
  id                          Int    @id
  name                        String
  description                 String
  selectableFeatureListId     Int
  requiredSelectableFeatureId Int?
  uses                        Int?
  actionType                  ActionType?

  selectableFeatureList  SelectableFeatureList @relation(fields: [selectableFeatureListId], references: [id])

  // Self-referencing relationship for required features
  requiredFeature        SelectableFeature?  @relation("FeatureRequirements", fields: [requiredSelectableFeatureId], references: [id])
  requiredByFeatures     SelectableFeature[] @relation("FeatureRequirements")

  // Relationship to CreatureSelectedFeature
  selectedFeatures  CreatureSelectedFeature[]
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
  type     UserType @default(PLAYER)
}

model Item {
  id                          Int    @id
  name                        String
  type                        GearType
  rank                        Int
  damageUnarmored             Int?
  damageArmored               Int?
  concealable                 Boolean @default(false)
  twoHanded                   Boolean @default(false)
  reach                       Boolean @default(false)
  finesse                     Boolean @default(false)
  thrown                      Boolean @default(false)
  attacksWorthOfAmmo          Int?
  rateOfFire                  RateOfFire?
  range                       Range?
  reliability                 Reliability?
  scatter                     Boolean @default(false)
  sniper                      Boolean @default(false)
  brace                       Boolean @default(false)
  armorType                   ArmorType?
  soak                        Int?
}

model CreatureItem {
  id          Int    @id @default(autoincrement())
  creatureId  Int
  itemId      Int
  count       Int   @default(0)
}