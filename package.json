{
  "name": "mfs-character-builder",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node dist/server/index.js",
    "server:build": "npx tsc --project tsconfig.server.json",
    "server:dev": "npx tsc --project tsconfig.server.json --watch & node dist/server/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "api:generate": "npx @openapitools/openapi-generator-cli generate -i api.yml -g typescript-axios -o src/api/generated",
    "api:docs": "npx @openapitools/openapi-generator-cli generate -i api.yml -g html2 -o docs/api"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.1.1",
    "@prisma/client": "^6.10.1",
    "@tanstack/react-query": "^5.80.10",
    "axios": "^1.10.0",
    "express": "^5.1.0",
    "prisma": "^6.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@openapitools/openapi-generator-cli": "^2.20.2",
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
