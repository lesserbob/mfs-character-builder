{
  "name": "mfs-character-builder",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-dev": "export VITE_API_URL=https://localhost:3443/api && npm run api:generate && export VITE_API_URL=https://localhost:3443/api && vite build",
    "build-prod": "export VITE_API_URL=https://d22cbvleeb4smp.cloudfront.net/api && npm run api:generate && export VITE_API_URL=https://d22cbvleeb4smp.cloudfront.net/api && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server": "node dist/server/index.js",
    "server:build": "npx tsc --project tsconfig.server.json",
    "server:dev": "npx tsc --project tsconfig.server.json --watch & node dist/server/index.js",
    "server:health": "curl -k https://localhost:3443/health",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:generate": "npx tsx scripts/generate-seed-from-db.ts",
    "db:export": "npx tsx scripts/export-data.ts",
    "api:generate": "npx @openapitools/openapi-generator-cli generate -i api.yml -g typescript-axios -o src/api/generated",
    "api:docs": "npx @openapitools/openapi-generator-cli generate -i api.yml -g html2 -o docs/api",
    "api:serve-docs": "npx http-server docs/api -p 8080 -o",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node dist/server/index.js",
    "postinstall": "prisma db push && prisma db seed"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.1.1",
    "@lexical/history": "^0.33.1",
    "@lexical/react": "^0.33.1",
    "@lexical/rich-text": "^0.33.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.1.1",
    "@prisma/client": "^6.10.1",
    "@tanstack/react-query": "^5.80.10",
    "@types/cors": "^2.8.19",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "konva": "^9.3.22",
    "lexical": "^0.33.1",
    "pg": "^8.16.3",
    "prisma": "^6.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.58.1",
    "react-konva": "^19.0.7",
    "react-router-dom": "^7.6.2",
    "react-to-pdf": "^2.0.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@openapitools/openapi-generator-cli": "^2.20.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "http-server": "^14.1.1",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.3.5"
  },
  "prisma": {
    "seed": "node dist/server/seed/seed.js"
  },
  "keywords": [],
  "author": ""
}
